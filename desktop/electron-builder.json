{
  "appId": "dev.ludens.app",
  "productName": "Ludens",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../client/out",
      "to": "out"
    },
    {
      "from": "../client/public",
      "to": "public"
    },
    {
      "from": "../docs",
      "to": "docs"
    },
    {
      "from": "dist/server",
      "to": "server"
    },
    {
      "from": "../core",
      "to": "core",
      "filter": [
        "**/*",
        "!node_modules/**",
        "!tests/**",
        "!python/.venv/**",
        "!python/**/__pycache__/**",
        "!*.tsbuildinfo"
      ]
    },
    {
      "from": "../baseware",
      "to": "baseware",
      "filter": [
        "**/*",
        "!node_modules/**",
        "!tests/**",
        "!*.tsbuildinfo"
      ]
    },
    {
      "from": "../protocol",
      "to": "protocol",
      "filter": [
        "**/*",
        "!node_modules/**",
        "!tests/**",
        "!*.tsbuildinfo"
      ]
    }
  ],
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "icon": "../client/public/brand/ludens-app-icon.png"
  },
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "../client/public/brand/ludens-app-icon.png"
  }
}

#!/bin/sh
set -eu
SCRIPT=$0
while [ -L "$SCRIPT" ]; do
  DIRECTORY=$(CDPATH= cd -P -- "$(dirname -- "$SCRIPT")" && pwd)
  SCRIPT=$(readlink "$SCRIPT")
  case "$SCRIPT" in /*) ;; *) SCRIPT=$DIRECTORY/$SCRIPT ;; esac
done
APP_ROOT=$(CDPATH= cd -P -- "$(dirname -- "$SCRIPT")/.." && pwd)
if [ -x "$APP_ROOT/node_modules/.bin/electron" ]; then
  exec "$APP_ROOT/node_modules/.bin/electron" "$APP_ROOT/dist/electron/main.js" "$@"
fi
exec "$APP_ROOT/../node_modules/.bin/electron" "$APP_ROOT/dist/electron/main.js" "$@"

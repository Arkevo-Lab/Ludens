{
  "name": "@ludens/app",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3015",
    "build": "node scripts/production.mjs build && node scripts/build-electron.mjs",
    "build:check": "node scripts/production.mjs check",
    "typecheck": "next typegen && tsc --noEmit && npm run desktop:typecheck",
    "test": "tsx --test tests/*.test.ts && npm run desktop:test",
    "start": "node scripts/production.mjs start",
    "desktop:build": "node scripts/build-electron.mjs",
    "desktop:typecheck": "tsc --noEmit -p desktop",
    "desktop:test": "vitest run",
    "desktop:start": "electron dist/electron/main.js",
    "pet:preview": "npm run desktop:build && electron dist/electron/companion-preview.js",
    "pet:smoke": "npm run desktop:build && electron dist/electron/companion-preview.js --smoke"
  },
  "dependencies": {
    "@ludens/protocol": "file:../protocol",
    "@ludens/core": "file:../core",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "electron": "39.8.10",
    "esbuild": "0.25.12",
    "jsdom": "29.0.0",
    "vitest": "4.1.5"
  },
  "main": "dist/electron/main.js",
  "bin": {
    "ludens-app": "./bin/ludens-app"
  }
}

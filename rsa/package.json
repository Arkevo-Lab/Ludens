{
  "name": "@ludens/rsa",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "rsa": "bun src/app/main.ts",
    "test": "bun run typescript:test && bun run python:test",
    "typecheck": "bun run typescript:typecheck && bun run python:typecheck",
    "typescript:test": "uv run --project python --frozen bun test",
    "typescript:typecheck": "tsc --noEmit",
    "python:test": "uv run --project python --frozen python scripts/test-python.py",
    "python:typecheck": "uv run --project python --frozen mypy --config-file python/pyproject.toml python/rsa_tools",
    "omp:test:transport": "bun test tests/omp-websocket.test.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "@ludens/baseware": "file:../baseware",
    "@ludens/protocol": "file:../protocol",
    "@oh-my-pi/omptype": "18.14.0",
    "@oh-my-pi/pi-agent-core": "18.14.0",
    "@oh-my-pi/pi-ai": "18.14.0",
    "@oh-my-pi/pi-catalog": "18.14.0",
    "@oh-my-pi/pi-coding-agent": "18.14.0",
    "@oh-my-pi/pi-utils": "18.14.0",
    "@oh-my-pi/snapcompact": "18.14.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "ajv": "8",
    "ignore": "^7.0.14",
    "smol-toml": "^1.9.1"
  }
}
